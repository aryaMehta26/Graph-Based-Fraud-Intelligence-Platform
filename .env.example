# Copy this file to .env and fill in your values
# .env is gitignored — never commit the real .env

NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DB=neo4j

# Set to "false" to skip betweenness centrality (much faster)
COMPUTE_BETWEENNESS=true
ANTHROPIC_API_KEY=your-anthropic-api-key-here
PROJ_ROOT=

# Dedicated QA database cleared and reloaded by the demo sync
NEO4J_DATABASE=fraudgraph
# Optional dataset folder for the additional EDA scripts
# AML_DATASET_DIR=/path/to/ibm-aml-dataset
