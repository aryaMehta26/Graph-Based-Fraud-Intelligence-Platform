# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Data files — too large for git (5.4 GB dataset lives on local machine only)
data/processed/*.parquet
data/processed/*.csv
data/neo4j_bulk_import/*.csv
data/neo4j_import/*.csv
*.parquet
*.csv

# Logs
logs/
*.log
airflow/logs/

# Environment
.env

# Raw IBM AML source files and local pattern extracts
data/raw/
raw/
HI-*.txt
HI-*.csv
*Patterns.txt

# Generated investigation/SFT data (may contain account IDs, transaction IDs,
# amounts, labels, or fraud-pattern instances)
artifacts/evaluation_dry_run/
artifacts/**/sft*.jsonl
artifacts/**/cases*.jsonl
artifacts/**/traces/
artifacts/llm_outputs/
artifacts/metrics/

# Model outputs and checkpoints
artifacts/adapters/
artifacts/checkpoints/
adapters/
checkpoints/
**/checkpoint-*/
*.safetensors
adapter_model.bin

# Hugging Face caches and local model downloads
.cache/huggingface/
.huggingface/
huggingface_cache/
.venv
venv/
*.egg-info/

# OS
.DS_Store
Thumbs.db

# Streamlit cache
.streamlit/secrets.toml

# Personal / academic documents
*.docx
*.doc
*.pdf
*.html

# Jupyter
.ipynb_checkpoints/

# Keep data folders tracked as empty
!data/.gitkeep
!data/processed/.gitkeep
!data/neo4j_bulk_import/.gitkeep
.env

# Local Airflow authentication
airflow/simple_auth_manager_passwords.json
